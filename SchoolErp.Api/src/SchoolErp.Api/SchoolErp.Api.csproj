<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ICU must stay on: invariant globalization drops the timezone database, so IANA ids like
         Asia/Kathmandu fail to resolve and every school-local date silently becomes UTC. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SchoolErp.Application\SchoolErp.Application.csproj" />
    <ProjectReference Include="..\SchoolErp.Infrastructure\SchoolErp.Infrastructure.csproj" />
  </ItemGroup>

</Project>
