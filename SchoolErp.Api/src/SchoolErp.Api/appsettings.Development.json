{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // DEVELOPMENT ONLY. Every school admin, teacher and student account created while this is set
  // gets this exact password, so test logins are predictable. Remove the setting (or clear the
  // value) to go back to a unique random password per account. Never set this in a deployed
  // environment — it makes every account on the system guessable.
  "Accounts": {
    "FixedPassword": "Admin@123"
  },
  // Local work only: whatever port the dev server happens to be on is allowed,
  // so moving ng serve does not mean editing config. Deployed environments use
  // the allowlist in appsettings.json.
  "Cors": {
    "AllowAll": true
  }
}
