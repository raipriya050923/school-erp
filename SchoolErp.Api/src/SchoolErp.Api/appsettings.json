{
  "ConnectionStrings": {
   "MySql": "Server=127.0.0.1;Port=3306;Database=school_erp;User Id=root;Password=YourStrongPassword@123;SslMode=Preferred;AllowUserVariables=true;ConvertZeroDateTime=true;"
    //"MySql":  "Server=127.0.0.1;Port=3306;Database=school_erp;User=root;Password=54321;SslMode=Disabled;AllowPublicKeyRetrieval=true;"
  },
  "Cors": {
    "AllowAll": true,
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  // Tenant scope comes from the signed school_id claim on the caller's token, not from config.
  // Key must be at least 32 characters; override it per environment (never ship this one).
  "Jwt": {
    "Key": "dev-only-school-erp-signing-key-change-me-in-production",
    "Issuer": "SchoolErp",
    "Audience": "SchoolErpClient",
    "ExpiryMinutes": 480
  },
  // FixedPassword gives every newly provisioned login the same password instead of a random one,
  // so demo accounts are easy to sign in as. Leave it empty anywhere real.
  "Accounts": {
    "FixedPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
